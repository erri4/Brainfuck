let c in Strings;
c := "Hello, World!";
print(c);
let f:Q -> Q;
f(x) := x+1;
let y in Q;
y := 4/3; // comment;
print(f(y));
let z in Q;
z := 1/2;
print(z+3);
print(z);
print(True);
print([z < 3/2]);
print(z in Z);
print(|Q|);
let s in Set;
s := {1, 2, 3};
print(s);
let s2 in Set;
s2 := {x in Q | x < 2};
print(3 in s2);
let vec1 in Q^2;
vec1 := (1, 2);
print(vec1 + (2, 3));
vec1_(1 + 0) := 5;
print(vec1);
print(1/2+1/2);
vec1_(1/2+1/2) := 10;
print(vec1);
vec1_0 := 3;
print(vec1_0);
let g: Q^2 -> Q;
g(x, y) := x + y;
print(g(3, 4));
let h in Q^Q;
h := lambda x.2*x;
print(h(5));
let func: Q->Q;
func(x) := cases{
    1 if x > 0,
    0 if x = 0,
    -1 else
};
print(func(10));
print(func(0));
print(func(-10));
print(func (100));
let r in Q;
let i in N;
r := Sigma_(i:=0)^(i=10) (i:=i+1, i-1);
print(r);
let prod in Q;
prod := Pi_(i in {1, 2, 3}) (i);
print(prod);
let cp in Set;
cp := Cap_(i in {{1, 2}, {2, 3}}) (i);
print(cp);
let map: EMPTYSET -> Q;
map() := 3;
print(map());
print(2^ALEPH_0);
print(P({1, 2, 3}));
print({1, 2, 1/2} in P(Q));
print(|P(Q)|);

print(dom(func));
print(range(func));
let x in Set;
x := {y in Q|y^2<2} or {y in Q|y<0};
print(0 in x);
print(1 in x);
print(2 in x);
print(1/2 in x);
print(-1/2 in x);
print(-1 in x);
print();
print(True);
let j: Q -> Q;
j(x):= x+3;
print(j(6));
print((j+3)(6));
print((j*3)(6));
print((j-3)(6));
print((j/4)(6));
print((func@j)(-3))